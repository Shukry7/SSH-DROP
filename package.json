{
  "name": "sshdrop",
  "version": "0.2.0-alpha.6",
  "description": "A cross-platform desktop SSH workspace with a terminal, remote file explorer, and explicit file transfers.",
  "productName": "SSHDrop",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "author": "SSHDrop contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shukry7/SSH-DROP.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "npm run version:check && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps",
    "security:audit": "node scripts/security-audit.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:package": "node scripts/check-package-security.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@>=9 <11.0.1": "11.0.1"
  }
}
